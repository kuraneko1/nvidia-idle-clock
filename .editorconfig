# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Scripts and the unit file in this repository are indented with 2 spaces
# (see `nvidia-idle-clock` and `install.sh`); do not reformat them to 4.
[*.sh]
indent_size = 2

[nvidia-idle-clock]
indent_size = 2

[*.service]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
# A trailing double space is Markdown's hard line break.
trim_trailing_whitespace = false
