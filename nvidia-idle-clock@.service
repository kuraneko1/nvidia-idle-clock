[Unit]
Description=Idle clock clamp for NVIDIA GPU %i (idle power saving)
Documentation=https://github.com/kuraneko1/nvidia-idle-clock
Documentation=https://github.com/kuraneko1/nvidia-idle-clock/blob/main/README.md

# No ConditionPathExists=/dev/nvidiactl here on purpose (#47). An unmet
# condition does not fail the unit, it *skips* it - once and permanently.
# Restart=on-failure never runs, the start-limit budget below is never entered,
# and no path/device unit pulls the service in when the driver creates the node
# later, so the power saving silently stays off for the rest of that boot.
# The driver check therefore lives in ExecStartPre below, where a missing node
# is an ordinary start failure that is logged and retried under the
# 30 restarts / 600s budget (~300s at RestartSec=10s) - enough for a slow
# driver. The cost is one journal entry per retry instead of a silent skip.

# Lower parallelism with the driver stack. Both units are optional: where they
# do not exist the ordering is simply ignored and nothing extra is pulled in.
# systemd-udev-settle.service is deliberately not used - it is deprecated and
# delays every boot.
After=nvidia-persistenced.service
After=dev-nvidiactl.device

# Restart budget (#11). 30 attempts at RestartSec=10s span roughly 300s, so a
# driver that needs tens of seconds is no longer left as a permanently failed
# unit. The interval is deliberately 600s and not 300s: systemd only trips the
# limit when restarts come faster than StartLimitIntervalSec / StartLimitBurst
# (20s here), and with 300s/30 a restart every 10s slides through the sliding
# window indefinitely - a permanent failure would never reach "failed".
# Measured with the values below: "failed" after 30 restarts at t=300s.
# The previous 5 attempts / 60s / 5s gave up after ~25s and left one boot-time
# miss as a failed unit for the rest of that boot.
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=simple
# The instance name is used directly as the target GPU (nvidia-smi index):
#   nvidia-idle-clock@0.service  -> GPU 0
#   nvidia-idle-clock@1.service  -> GPU 1
# Assign a different GPU, or override settings for one GPU, with a drop-in:
#   sudo systemctl edit nvidia-idle-clock@0.service
#     [Service]
#     Environment=GPU=2            # serve another GPU
#     Environment=IDLE_CAP=555     # relax the cap for this GPU only
#     Environment=IDLE_SECONDS=120
Environment=GPU=%i
Environment=IDLE_CAP=135
Environment=IDLE_SECONDS=30

# Reject a non-numeric instance name before the daemon starts (#30). The
# instance is used verbatim as the GPU index, so anything else can only fail
# later inside the script - after a restart loop that ends in start-limit, with
# "Start request repeated too quickly" as the only hint. systemd escapes unit
# names, so %i cannot break out of the quotes below.
# A non-numeric instance that gets its GPU from a drop-in (Environment=GPU=...)
# is now rejected too; reset the list in the same drop-in with a bare
# "ExecStartPre=" if you rely on that.
ExecStartPre=/bin/sh -c 'case "%i" in ""|*[!0-9]*) echo "nvidia-idle-clock: invalid GPU instance %i" >&2; exit 1;; esac'

# Fail fast (and visibly) while the NVIDIA driver has not created its control
# node yet. Unlike a condition this is retried by Restart=on-failure, see the
# start-limit budget in [Unit]. Runs after the instance check so a permanent
# configuration error is reported as such even while the device is missing.
# The check goes through /bin/sh and not /usr/bin/test: ExecStartPre needs an
# absolute path, /bin/sh is required by the FHS while a coreutils at /usr/bin is
# not (NixOS has no /usr at all). A helper the host does not have would fail the
# unit with 203/EXEC instead of answering "is the driver there yet".
ExecStartPre=/bin/sh -c 'test -e /dev/nvidiactl'

ExecStart=/usr/local/sbin/nvidia-idle-clock
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
# A permanent mistake must not be retried: exit 3 means another instance already
# manages this GPU, exit 2 means the configuration or the argument list is
# invalid (the daemon's die_config and unknown-argument paths). Nothing was
# touched in either case and a retry can never succeed, so Restart=on-failure
# would only burn the 30-restart / ~300s budget and repeat the same error line.
# Both statuses are permanent by construction; a genuine driver or IO failure
# exits 1 and is still retried.
RestartPreventExitStatus=2 3

# The daemon releases its own clamp from the EXIT trap, which a SIGKILL, an OOM
# kill or a stop that reached TimeoutStopSec can never run. This runs after
# *every* stop - including SIGKILL - and releases exactly the GPUs that carry a
# state marker; a GPU this unit never clamped is left alone (#9, #20). The
# leading "-" keeps a failed release from changing the unit result: the daemon
# itself already reports failure where it can.
# The uninstaller's keep-clocks marker covers these stop paths only: a start
# ignores it and still releases stale markers, so a Restart= or a manual start
# during --keep-clocks does not preserve the old clamp.
ExecStopPost=-/usr/local/sbin/nvidia-idle-clock --unlock

# Sandboxing (#10). The unit runs bash + nvidia-smi and logs to the journal, so
# it needs no writable file system, no /home, no network and no kernel
# interfaces. Device access is untouched: PrivateDevices= and DevicePolicy= are
# deliberately not set, /dev/nvidia* stays reachable exactly as before.
#
# The one writable path is the state directory (STATE_DIR, default
# /run/nvidia-idle-clock). ProtectSystem=strict makes /run read-only as well, so
# the daemon could not create its markers without an allowance. A narrower
# ReadWritePaths=/run/nvidia-idle-clock cannot be used: while that directory
# does not exist yet (any fresh boot) systemd fails the whole unit with
# "Failed to set up mount namespacing: No such file or directory"
# (226/NAMESPACE, verified with systemd 255), and the daemon cannot create it
# while /run is read-only. RuntimeDirectory= is deliberately not used either:
# systemd deletes it when the unit stops, i.e. exactly when a marker has to
# survive for --unlock. The system parts of /run stay read-only; AF_UNIX sockets
# (journald, logind) keep working, as those are unaffected by these options.
ReadWritePaths=/run
ReadOnlyPaths=/run/systemd /run/udev /run/log
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
RemoveIPC=yes
UMask=0077

# CapabilityBoundingSet= and SystemCallFilter= are intentionally left at the
# systemd defaults. nvidia-smi -lgc/-rgc goes through NVML ioctls on
# /dev/nvidiactl and the exact capability set it needs (CAP_SYS_ADMIN and
# possibly more) has not been validated on hardware. A wrong value here turns
# the daemon into a restart loop on the owner's machine, which is worse than
# the hardening it would buy. Validate -lgc/-rgc on a test GPU before adding
# either, then tighten the bounding set first.

[Install]
WantedBy=multi-user.target
