[Unit]
Description=Idle clock clamp for NVIDIA GPUs (idle power saving)
StartLimitIntervalSec=0

[Service]
Type=simple
# 対象 GPU (nvidia-smi index)。複数枚はカンマ区切り: Environment=GPU=0,1
Environment=GPU=0
Environment=IDLE_CAP=135
Environment=IDLE_SECONDS=30
ExecStart=/usr/local/sbin/nvidia-idle-clock
Restart=always
RestartSec=5s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
